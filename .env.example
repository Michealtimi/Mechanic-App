# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/mechanic_app

# ============================================================================
# JWT Authentication
# ============================================================================
# Generate a strong secret: openssl rand -hex 32
# Minimum 64 characters recommended for production
JWT_SECRET=your-jwt-secret-key-change-in-production-min-64-chars
JWT_EXPIRES_IN=24h
# Access token (used by auth module)
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
# Refresh token (used by auth module)
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES=7d
# Frontend base URL (for password reset links, etc.)
FRONTEND_URL=http://localhost:3001

# ============================================================================
# Redis Configuration (for BullMQ queues and Socket.IO)
# ============================================================================
# Redis host (default: localhost)
REDIS_HOST=localhost
# Redis port (default: 6379)
REDIS_PORT=6379
# Redis password (optional, leave empty if not required)
REDIS_PASSWORD=
# Alternative: Use REDIS_URL instead of separate host/port/password
# REDIS_URL=redis://localhost:6379

# ============================================================================
# Payment Gateways
# ============================================================================
# Paystack Configuration
# Get keys from: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_WEBHOOK_SECRET=whsec_your_paystack_webhook_secret

# Flutterwave Configuration
# Get keys from: https://dashboard.flutterwave.com/settings/apis
FLW_SECRET_KEY=FLWSECK_TEST_your_flutterwave_secret_key
FLW_PUBLIC_KEY=FLWPUBK_TEST_your_flutterwave_public_key
FLW_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# Payment Gateway Selection
# Options: SANDBOX, PAYSTACK, FLUTTERWAVE
# SANDBOX: Mock payment gateway for development/testing
PAYMENT_GATEWAY=SANDBOX

# Multi-region routing (JSON): country/currency → gateway name
# PAYMENT_GATEWAY_BY_COUNTRY={"NG":"PAYSTACK","US":"STRIPE","KE":"FLUTTERWAVE","GB":"STRIPE"}
# PAYMENT_GATEWAY_BY_CURRENCY={"NGN":"PAYSTACK","USD":"STRIPE","EUR":"STRIPE"}

# Stripe (global card payments)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Redis-backed rate limiting (uses REDIS_* above)
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
THROTTLE_LOGIN_LIMIT=5
THROTTLE_REDIS_PREFIX=mech:throttle

# Global platform defaults (ISO 4217 currency, BCP 47 locale)
DEFAULT_CURRENCY=NGN
DEFAULT_LOCALE=en-NG

# Google OAuth (required for production Google sign-in)
GOOGLE_CLIENT_ID=

# Swagger (disabled in production unless true)
SWAGGER_ENABLED=false

# Object storage: local | s3
STORAGE_PROVIDER=local
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# ============================================================================
# Maps/Geocoding (OpenStreetMap/Nominatim)
# ============================================================================
# Optional: override if you run your own Nominatim endpoint
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Optional: custom user agent for geocoding policy compliance
# NOMINATIM_USER_AGENT=mechanic-app-backend/1.0

# ============================================================================
# Email Configuration (Nodemailer)
# ============================================================================
# SMTP server host (Gmail example shown)
SMTP_HOST=smtp.gmail.com
# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587
# SMTP username (your email address)
SMTP_USER=your-email@gmail.com
# SMTP password (use App Password for Gmail, not regular password)
SMTP_PASS=your-app-password

# ============================================================================
# Encryption (for webhook secrets, API keys)
# ============================================================================
# Generate: openssl rand -hex 32
# MUST be exactly 64 hex characters (32 bytes)
# Used for encrypting sensitive data like webhook secrets and API keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================================================
# Telemetry Providers (Phase 2 - Optional)
# ============================================================================
# Smartcar API credentials
# Get from: https://smartcar.com/developers/
SMARTCAR_CLIENT_ID=your_smartcar_client_id
SMARTCAR_CLIENT_SECRET=your_smartcar_client_secret

# Tor Loco API key
# Get from: https://torloco.com/
TOR_LOCO_API_KEY=your_tor_loco_api_key

# Open Charge Map API key (optional)
# Has demo key available, get from: https://openchargemap.org/site/develop/api
OPEN_CHARGE_MAP_API_KEY=demo_key

# ============================================================================
# Webhook Secrets (Phase 2)
# ============================================================================
# Secrets for verifying webhook signatures from telemetry providers
SMARTCAR_WEBHOOK_SECRET=your_smartcar_webhook_secret
TOR_LOCO_WEBHOOK_SECRET=your_tor_loco_webhook_secret

# ============================================================================
# API Configuration (Phase 3)
# ============================================================================
# Secret for API key hashing
# Generate: openssl rand -hex 32
# Used to hash API keys before storing in database
API_KEY_SECRET=your_api_key_secret_change_in_production

# ============================================================================
# Invisible Foreman: Platform Config (rely on env; optional overrides)
# ============================================================================
# Dispatch radius in km (default: 10)
# DISPATCH_RADIUS_KM=10
# Geofence radius in metres — mechanic must be within to start job (default: 200)
# GEOFENCE_RADIUS_METRES=200
# First wave: number of mechanics to offer (default: 3)
# DISPATCH_FIRST_WAVE_SIZE=3
# Second wave after timeout: number of new offers (default: 5)
# DISPATCH_SECOND_WAVE_SIZE=5
# Offer timeout in ms, e.g. 2 min (default: 120000)
# DISPATCH_OFFER_TIMEOUT_MS=120000
# Platform commission percent when booking has no stored fee (default: 10)
# PLATFORM_COMMISSION_PERCENT=10

# Base URL for receipt image links (e.g. https://api.yourapp.com)
APP_URL=http://localhost:3000

# ============================================================================
# Application Configuration
# ============================================================================
# Server port (default: 3000)
PORT=3000
# Environment: development, staging, production
NODE_ENV=development
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Optional: Payment Reconciliation
# ============================================================================
# Batch size for payment reconciliation cron job
PAYMENT_RECONCILE_BATCH_SIZE=200

# ============================================================================
# Optional: SMS Provider (Twilio - if implemented)
# ============================================================================
# Uncomment if using Twilio for SMS notifications
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ============================================================================
# Test Database (for testing)
# ============================================================================
# Separate database for running tests
# TEST_DATABASE_URL=postgresql://test:test@localhost:5432/test_db
