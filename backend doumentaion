3️⃣ Database Schema
Core Tables
User: id, name, email, phone, roles, orgIds, avatarUrl, softDelete


Organization: id, name, ownerId, type(B2B/B2C), walletBalance


Vehicle: id, orgId, VIN, type(EV/ICE), telematics(json), status, lat, lng


Booking: id, customerId, vehicleId, orgId, status, totalPrice, platformFee


BookingSegment: id, bookingId, mechanicId, type, status, price


Payment: id, bookingSegmentId, walletFrom, walletTo, amount, status, paymentGatewayId


Dispute: id, bookingSegmentId, evidenceUrls, status, escalationLevel


EVMetrics: id, vehicleId, batteryLevel, SOC, rangeKm, timestamp


AuditLog: id, entity, entityId, action, actorId, timestamp



